{
	"name": "cline-evals",
	"version": "2.0.0",
	"description": "Evaluation framework for Cline: smoke tests, analysis, and benchmarks",
	"scripts": {
		"analysis": "cd analysis && npm start --",
		"harness:matrix": "bun harness-stress/src/matrix.ts",
		"harness:provider-smoke": "bun harness-stress/src/provider-smoke.ts",
		"harness:serve": "node harness-stress/src/cli.mjs",
		"harness:smoke": "node harness-stress/src/smoke.mjs",
		"harness:test": "node --test harness-stress/test/*.test.mjs"
	},
	"license": "MIT",
	"dependencies": {
		"better-sqlite3": "^12.4.1",
		"chalk": "5.6.2",
		"commander": "^9.4.1",
		"dotenv": "^16.5.0",
		"tiktoken": "^1.0.21"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.3",
		"@types/node": "^18.11.18",
		"ts-node": "^10.9.1",
		"typescript": "^4.9.4"
	}
}
