+// Bun's net.Socket cannot read an inherited pipe fd and fs.createReadStream
+// rejects the non-blocking fd with EAGAIN, so read it through Bun.file and
+// close the fd once the stream is done.
+function bunReadable(fd) {
+    const stream = Readable.fromWeb(Bun.file(fd).stream());
+    let closed = false;
+    stream.once('close', () => {
+        if (closed)
+            return;
+        closed = true;
+        try {
+            fs.closeSync(fd);
+        }
+        catch {
+            // Already closed.
+        }
+    });
+    return stream;
