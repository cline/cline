# 21 Agent — copy to .env.local and fill in.
# Browser-safe values (exposed to the client by Next.js):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter: platform default key used when a user has not saved their own.
# https://openrouter.ai/keys — the platform works without it if users BYOK.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=21 Agent

# Daytona cloud sandboxes: https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DAYTONA_WORKSPACE_ROOT=workspace
SANDBOX_PROVIDER=daytona

APP_URL=http://localhost:3000
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
# Shared secret for the internal worker tick endpoint
WORKER_INTERNAL_SECRET=
WORKER_POLL_MS=1500
WORKER_LEASE_SECONDS=120
