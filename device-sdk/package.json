{
	"name": "@cline/device",
	"version": "0.0.90",
	"description": "Cline device protocol, ESP-IDF firmware, board profiles, and versioned avatar assets",
	"type": "module",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/cline/cline",
		"directory": "device-sdk"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./assets": {
			"types": "./dist/assets.d.ts",
			"import": "./dist/assets.js"
		},
		"./assets/manifest.json": "./assets/avatars/manifest.json"
	},
	"files": [
		"dist",
		"assets",
		"firmware/CMakeLists.txt",
		"firmware/sdkconfig.defaults",
		"firmware/components",
		"firmware/main",
		"firmware/devices",
		"firmware/tools/*.ts",
		"firmware/tools/*.py",
		"web"
	],
	"scripts": {
		"build": "bun tsc -p tsconfig.json",
		"typecheck": "bun tsc -p tsconfig.json --noEmit",
		"test": "bun test src firmware/tests",
		"test:unit": "bun test src firmware/tests",
		"validate:assets": "python3 firmware/tools/sprites.py --check",
		"firmware": "bun firmware/tools/build.ts"
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"@types/node": "^25.3.5",
		"@types/bun": "^1.4.2"
	}
}
