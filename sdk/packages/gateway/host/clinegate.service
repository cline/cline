[Unit]
Description=Cline Gateway host authority and agent runtime
Documentation=https://github.com/cline/cline/tree/main/sdk/packages/gateway
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
Environment=NODE_ENV=production
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/clinegate serve --data-root %h/.cline/gateway --namespace default --remote-host 127.0.0.1 --remote-port 18080 --remote-token remote-access --allow-insecure-remote
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
