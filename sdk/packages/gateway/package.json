{
	"name": "@cline/gateway",
	"version": "0.0.75",
	"description": "Cline Gateway — runtime authority for the Gateway RFC (protocol, SQLite authority, singleton lock, async runtime, lifecycle CLI)",
	"repository": {
		"type": "git",
		"url": "https://github.com/cline/cline",
		"directory": "sdk/packages/gateway"
	},
	"private": true,
	"internal": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"cline-gateway": "bin/cline-gateway.mjs",
		"cline-gateway-worker": "bin/cline-gateway-worker.mjs"
	},
	"files": [
		"dist",
		"bin"
	],
	"license": "Apache-2.0",
	"scripts": {
		"build": "bun run bun.mts && bun tsc -p tsconfig.build.json",
		"docker:build": "docker build -f docker/Dockerfile -t cline-gateway:dev ../../..",
		"typecheck": "bun tsc -p tsconfig.dev.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "^0.0.73",
		"@cline/bot": "workspace:*",
		"@cline/engine": "workspace:*",
		"@cline/shared": "workspace:*",
		"@cline/tools": "workspace:*",
		"ws": "^8.18.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/ws": "^8.5.13"
	}
}
