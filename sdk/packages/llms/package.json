{
	"name": "@bedrock-coder/llms",
	"version": "0.1.0",
	"private": true,
	"description": "Amazon Bedrock runtime for Bedrock Coder agents",
	"repository": {
		"type": "git",
		"url": "https://github.com/FFFalexgo/AWS_Bedrock_Coder",
		"directory": "sdk/packages/llms"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"browser": "./dist/index.browser.js",
			"react-server": "./dist/index.browser.js",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./browser": {
			"import": "./dist/index.browser.js",
			"types": "./dist/index.browser.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun run bun.mts && bun tsc -p tsconfig.build.json",
		"typecheck": "bun tsc -p tsconfig.dev.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "^4.0.89",
		"@aws-sdk/credential-providers": "^3.922.0",
		"@bedrock-coder/shared": "workspace:*",
		"@smithy/node-http-handler": "^4.9.5",
		"ai": "^6.0.144",
		"nanoid": "^5.1.7",
		"undici": "^7.28.0"
	}
}
