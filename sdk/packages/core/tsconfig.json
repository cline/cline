{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "..",
		"noEmit": true,
		"paths": {
			"@bedrock-coder/agents": ["../agents/src/index.ts"],
			"@bedrock-coder/agents/*": ["../agents/src/*", "../agents/src/*/index.ts"],
			"@bedrock-coder/llms": ["../llms/src/index.ts"],
			"@bedrock-coder/llms/browser": ["../llms/src/index.browser.ts"],
			"@bedrock-coder/shared": ["../shared/src/index.ts"],
			"@bedrock-coder/shared/automation": ["../shared/src/automation/index.ts"],
			"@bedrock-coder/shared/browser": ["../shared/src/index.browser.ts"],
			"@bedrock-coder/shared/db": ["../shared/src/db/index.ts"],
			"@bedrock-coder/shared/storage": ["../shared/src/storage/index.ts"],
			"@bedrock-coder/shared/types": ["../shared/src/types/index.ts"],
			"@bedrock-coder/shared/*": ["../shared/src/*", "../shared/src/*/index.ts"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "fixtures"]
}
