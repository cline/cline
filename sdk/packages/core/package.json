{
	"name": "@bedrock-coder/core",
	"description": "Bedrock Coder core runtime for Node.js",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/FFFalexgo/AWS_Bedrock_Coder",
		"directory": "sdk/packages/core"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"private": true,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./hub": {
			"types": "./dist/hub/index.d.ts",
			"import": "./dist/hub/index.js"
		},
		"./hub/daemon-entry": {
			"types": "./dist/hub/daemon/entry.d.ts",
			"import": "./dist/hub/daemon/entry.js"
		}
	},
	"scripts": {
		"build": "bun run ./bun.mts && bun tsc -p tsconfig.build.json",
		"typecheck": "bun tsc -p tsconfig.dev.json --noEmit && bun run typecheck:smoke",
		"typecheck:smoke": "bun tsc -p tsconfig.smoke.json --noEmit",
		"test": "bun run test:unit && bun run test:e2e",
		"test:live": "vitest run --config vitest.config.ts src/extensions/context/compaction.live.test.ts",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"test:watch": "vitest --config vitest.config.ts"
	},
	"dependencies": {
		"@bedrock-coder/agents": "workspace:*",
		"@bedrock-coder/shared": "workspace:*",
		"@bedrock-coder/llms": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"jiti": "^2.7.0",
		"nanoid": "^5.1.7",
		"simple-git": "3.36.0",
		"ws": "^8.20.0",
		"yaml": "^2.8.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/ws": "^8.18.1"
	},
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"!dist/**/*.d.ts.map"
	]
}
