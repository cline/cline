{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": false,
		"types": ["node", "react"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
