# Shared team installation.
TRAEFIK_ACME_EMAIL=admin@example.com
CLINE_GATE_IMAGE=cline-bots-gateway:dev

# Real hostname resolving to this VM. A wildcard such as *.gate.example.com
# should also resolve to the VM before the admin panel provisions users.
CLINE_TEAM_ROOT_DOMAIN=root.gate.example.com

# Official web UI allowed to connect to team Gates.
CLINE_SIDECAR_TRUSTED_ORIGINS=https://cline-gateway-connect.cline-8362.chatgpt.site
CLINE_GATEWAY_LEAD_PROFILE=cline

# Initial root Gate allocation.
CLINE_ROOT_CPU_LIMIT=2
CLINE_ROOT_MEMORY_LIMIT=4G
