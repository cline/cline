# Same image is used by personal, team, and future k3s deployments.
CLINE_GATE_IMAGE=cline-bots-gateway:dev

# Bare public hostname routed to this user's container.
CLINE_GATEWAY_DOMAIN=alice.gate.example.com

# DNS-safe unique identifier used in Traefik router/service names.
CLINE_GATE_ROUTE_ID=alice

# Browser UI origins allowed to connect to this Gate.
CLINE_SIDECAR_TRUSTED_ORIGINS=https://cline-gateway-connect.cline-8362.chatgpt.site

# Built-in root bot profile: cline or cline-dad.
CLINE_GATEWAY_LEAD_PROFILE=cline
