# A DNS name that resolves to this VM. nip.io works without creating a DNS record:
# for public IP 35.254.245.28 use gateway.35-254-245-28.nip.io.
CLINE_GATEWAY_DOMAIN=gateway.203-0-113-10.nip.io

# The official hosted UI is trusted by default. Add comma-separated origins only
# when hosting another copy of gateway-ui.
CLINE_SIDECAR_TRUSTED_ORIGINS=https://cline-gateway-connect.cline-8362.chatgpt.site

# cline is the default; cline-dad is also supported.
CLINE_GATEWAY_LEAD_PROFILE=cline

# Change these when running several teammate stacks on one VM behind an outer
# reverse proxy. A single directly exposed stack normally keeps 80 and 443.
CLINE_HTTP_PORT=80
CLINE_HTTPS_PORT=443

# For a stack behind a shared host ingress, use :8080 and bind its published
# ports to loopback. Leave blank for direct automatic HTTPS.
CLINE_CADDY_SITE_ADDRESS=
CLINE_BIND_ADDRESS=0.0.0.0
