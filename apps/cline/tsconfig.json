{
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"target": "ES6",
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./*"],
			"@cline/gateway/*": ["../../sdk/packages/gateway/src/*"],
			"@cline/llms": ["../../sdk/packages/llms/src/index.ts"],
			"@cline/shared/agent": ["../../sdk/packages/shared/src/agent.ts"],
			"@cline/shared/automation": [
				"../../sdk/packages/shared/src/automation/index.ts"
			],
			"@cline/shared/browser": [
				"../../sdk/packages/shared/src/index.browser.ts"
			],
			"@cline/shared/connectors": [
				"../../sdk/packages/shared/src/connectors/index.ts"
			],
			"@cline/shared/gateway": [
				"../../sdk/packages/shared/src/gateway/index.ts"
			]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
