{
	"name": "@cline/mobile",
	"version": "0.0.2",
	"private": true,
	"main": "index.js",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"test": "vitest run",
		"test:watch": "vitest",
		"export:ios": "EXPO_PUBLIC_ENV=production expo export --platform ios --output-dir dist/export-ios",
		"export:android": "EXPO_PUBLIC_ENV=production expo export --platform android --output-dir dist/export-android",
		"export:smoke": "bun run export:ios && bun run export:android",
		"e2e:smoke": "maestro test .maestro/connect-smoke.yaml",
		"tokens:generate": "bun run scripts/generate-tokens.ts",
		"tokens:check": "bun run scripts/check-tokens.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@cline/core": "workspace:*",
		"@cline/hub-client": "workspace:*",
		"@cline/hub-pairing": "workspace:*",
		"@cline/hub-relay": "workspace:*",
		"@cline/shared": "workspace:*",
		"@cline/ui": "workspace:*",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@react-native-masked-view/masked-view": "0.3.2",
		"expo": "~57.0.9",
		"expo-audio": "~57.0.5",
		"expo-blur": "~57.0.2",
		"expo-camera": "~57.0.3",
		"expo-clipboard": "~57.0.2",
		"expo-constants": "~57.0.8",
		"expo-document-picker": "~57.0.3",
		"expo-file-system": "~57.0.7",
		"expo-font": "~57.0.1",
		"expo-image-picker": "~57.0.15",
		"expo-linear-gradient": "~57.0.1",
		"expo-linking": "~57.0.4",
		"expo-router": "~57.0.9",
		"expo-secure-store": "~57.0.1",
		"expo-speech-recognition": "^56.0.3",
		"expo-splash-screen": "~57.0.10",
		"expo-status-bar": "~57.0.1",
		"expo-system-ui": "~57.0.2",
		"expo-video": "~57.0.5",
		"lucide-react-native": "^1.28.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.2",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-get-random-values": "~1.11.0",
		"react-native-keyboard-controller": "1.21.9",
		"react-native-reanimated": "4.5.3",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-web": "~0.21.0",
		"react-native-worklets": "0.10.1",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@cline/hub-testkit": "workspace:*",
		"@types/node": "^25.3.5",
		"@types/react": "~19.2.2",
		"babel-preset-expo": "~57.0.5",
		"react-test-renderer": "19.2.3",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
