menu "Cline Pet"

    config PET_FW_VERSION
        string "Firmware version reported to the bridge"
        default "0.1.0"

    config PET_DEVICE_NAME
        string "Device name shown in the bridge's device list"
        default "cline-pet"

    config PET_BRIDGE_DEFAULT_PORT
        int "Bridge port when a manual host has no :port"
        default 25470

    menu "Behaviour"
        config PET_WORK_FPS
            int "Working animation frames per second (2-4)"
            range 1 4
            default 3
        config PET_FULL_REFRESH_EVERY
            int "Full (anti-ghosting) refresh after this many partial refreshes"
            default 30
        config PET_SLEEP_MIN
            int "Minutes idle before the pet falls asleep (display stops refreshing)"
            default 5
        config PET_DEEP_SLEEP_MIN
            int "Minutes asleep before chip deep sleep (0 = never; wake via button/touch)"
            default 0
        config PET_MAX_RECORDING_S
            int "Maximum push-to-talk recording length (seconds)"
            range 5 60
            default 30
    endmenu

    # ---------------------------------------------------------------------
    # Pin map. Defaults match the Waveshare ESP32-S3-(Touch-)ePaper-1.54
    # (V1 and V2), taken from waveshareteam/ESP32-S3-ePaper-1.54 examples.
    # ---------------------------------------------------------------------
    menu "E-paper pins (SPI)"
        config PET_EPD_MOSI
            int "MOSI"
            default 13
        config PET_EPD_SCLK
            int "SCLK"
            default 12
        config PET_EPD_CS
            int "CS"
            default 11
        config PET_EPD_DC
            int "DC"
            default 10
        config PET_EPD_RST
            int "RST"
            default 9
        config PET_EPD_BUSY
            int "BUSY"
            default 8
        config PET_EPD_PWR
            int "Panel power enable GPIO (-1 = none)"
            default 6
        config PET_EPD_PWR_ACTIVE_LEVEL
            int "Panel power enable active level"
            range 0 1
            default 0
    endmenu

    menu "Touch (I2C)"
        config PET_I2C_SDA
            int "SDA"
            default 47
        config PET_I2C_SCL
            int "SCL"
            default 48
        config PET_TOUCH_ADDR
            hex "Touch controller address (FT6336 0x38, CST816 0x15)"
            default 0x38
        config PET_TOUCH_RST
            int "Touch RST (-1 = none)"
            default 7
        config PET_TOUCH_INT
            int "Touch INT, also a deep-sleep wake source (-1 = none)"
            default 21
        config PET_TOUCH_SWAP_XY
            bool "Swap X/Y"
            default n
        config PET_TOUCH_INVERT_X
            bool "Invert X"
            default n
        config PET_TOUCH_INVERT_Y
            bool "Invert Y"
            default n
    endmenu

    menu "Microphone (I2S)"
        choice PET_MIC_TYPE
            prompt "Microphone type"
            default PET_MIC_ES8311
            config PET_MIC_ES8311
                bool "ES8311 codec (Waveshare ePaper-1.54)"
            config PET_MIC_STD
                bool "Standard I2S MEMS mic (INMP441-style)"
            config PET_MIC_PDM
                bool "PDM MEMS mic"
        endchoice
        config PET_MIC_MCLK
            int "MCLK (-1 = unused; the ES8311 needs it)"
            default 14
        config PET_MIC_SCK
            int "BCLK (PDM: CLK)"
            default 15
        config PET_MIC_WS
            int "WS / LRCLK (ignored for PDM)"
            default 38
        config PET_MIC_SD
            int "DIN (data from mic/codec to the ESP32)"
            default 16
        config PET_MIC_GAIN_DB
            int "ES8311 input gain (dB)"
            depends on PET_MIC_ES8311
            range 0 42
            default 30
        config PET_MIC_RIGHT_SLOT
            bool "Mic outputs on the right slot (L/R pin high)"
            depends on PET_MIC_STD
            default n
        config PET_MIC_GAIN_SHIFT
            int "Digital gain as a left shift (0-4) for 32-bit slot mics"
            depends on PET_MIC_STD
            range 0 4
            default 2
        config PET_AUDIO_PWR
            int "Audio/codec power enable GPIO (-1 = none)"
            default 42
        config PET_AUDIO_PWR_ACTIVE_LEVEL
            int "Audio power enable active level"
            range 0 1
            default 0
        config PET_SPEAKER_PA
            int "Speaker amplifier enable GPIO, held off (-1 = none)"
            default 46
    endmenu

    config PET_VBAT_HOLD
        int "Battery power-latch GPIO, driven high at boot (-1 = none)"
        default 17

    config PET_PTT_BUTTON
        int "Push-to-talk button GPIO, active low (-1 = none; 0 = BOOT)"
        default 0

endmenu
