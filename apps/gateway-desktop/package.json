{
	"name": "@cline/gateway-desktop",
	"version": "0.0.1",
	"private": true,
	"description": "Gateway Desktop — a native macOS validation client for the Phase 3 clinegate",
	"type": "module",
	"scripts": {
		"build:ui": "bun -F @cline/ui build",
		"predev:web": "bun run build:ui",
		"dev:web": "next dev webview -p 3135 --turbo",
		"dev:broker": "GATEWAY_DESKTOP_DEV_BRIDGE=1 bun run native/index.ts",
		"dev": "tauri dev",
		"prebuild": "bun run build:ui",
		"build": "bun run bun.mts",
		"build:sidecars": "bun run scripts/build-broker-bin.ts",
		"build:broker:bin": "bun run build:sidecars",
		"build:binary": "tauri build",
		"pretypecheck": "bun run build:ui",
		"typecheck": "tsc -p tsconfig.dev.json --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"second-client": "bun run native/second-client.ts",
		"clean": "rm -rf webview/.next webview/out node_modules dist && (cd src-tauri && rm -rf target)"
	},
	"dependencies": {
		"@cline/gateway": "workspace:*",
		"@cline/shared": "workspace:*",
		"@cline/ui": "workspace:*",
		"@fontsource-variable/geist-mono": "^5.2.8",
		"@fontsource-variable/inter": "^5.2.8",
		"@streamdown/cjk": "^1.0.3",
		"@radix-ui/react-scroll-area": "1.2.10",
		"@radix-ui/react-select": "2.2.6",
		"@radix-ui/react-separator": "1.1.8",
		"@radix-ui/react-slot": "1.2.4",
		"@radix-ui/react-tooltip": "1.2.8",
		"@tauri-apps/api": "^2.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.564.0",
		"next": "16.2.11",
		"next-themes": "^0.4.6",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.3.1",
		"ws": "^8.18.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cline/bot": "workspace:*",
		"@tailwindcss/postcss": "^4.2.0",
		"@tauri-apps/cli": "^2.0.0",
		"@types/bun": "^1.3.14",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/ws": "^8.5.13",
		"postcss": "^8.5",
		"tailwindcss": "^4.2.0",
		"tw-animate-css": "1.3.3",
		"typescript": "5.7.3",
		"vitest": "^4.0.18"
	},
	"engines": {
		"node": ">=22"
	}
}
