{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Cline",
				"width": 1500,
				"height": 980,
				"preventOverflow": true,
				"resizable": true,
				"decorations": false,
				"shadow": true,
				"visible": false,
				"dragDropEnabled": false
			}
		]
	},
	"bundle": {
		"resources": ["icons/app/*.png", "bin/remote-helpers/*"],
		"windows": {
			"nsis": {
				"installerHooks": "nsis/installer-hooks.nsh"
			}
		}
	}
}
