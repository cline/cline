{
	"name": "cline-desktop-preview",
	"displayName": "Cline Desktop (Preview)",
	"description": "Prototype: the Cline desktop app's UI and backend hosted inside a VS Code extension.",
	"version": "0.0.1",
	"private": true,
	"publisher": "cline",
	"icon": "media/icon.png",
	"license": "Apache-2.0",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Other"
	],
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"commands": [
			{
				"command": "clineDesktop.open",
				"title": "Open in Editor Tab",
				"category": "Cline Desktop",
				"icon": "$(link-external)"
			},
			{
				"command": "clineDesktop.restartBackend",
				"title": "Restart Backend",
				"category": "Cline Desktop"
			},
			{
				"command": "clineDesktop.showLogs",
				"title": "Show Backend Logs",
				"category": "Cline Desktop"
			},
			{
				"command": "clineDesktop.newSession",
				"title": "New Session",
				"category": "Cline Desktop",
				"icon": "$(add)"
			},
			{
				"command": "clineDesktop.searchSessions",
				"title": "Search Sessions",
				"category": "Cline Desktop",
				"icon": "$(search)"
			},
			{
				"command": "clineDesktop.openSettings",
				"title": "Settings",
				"category": "Cline Desktop",
				"icon": "$(gear)"
			},
			{
				"command": "clineDesktop.focusInput",
				"title": "Focus Chat Input",
				"category": "Cline Desktop"
			},
			{
				"command": "clineDesktop.showSessions",
				"title": "Session History",
				"category": "Cline Desktop",
				"icon": "$(history)"
			},
			{
				"command": "clineDesktop.addToCline",
				"title": "Add to Cline",
				"category": "Cline Desktop"
			}
		],
		"keybindings": [
			{
				"command": "clineDesktop.newSession",
				"key": "ctrl+shift+n",
				"mac": "cmd+shift+n",
				"when": "focusedView == clineDesktop.sidebar || activeWebviewPanelId == clineDesktop.panel"
			},
			{
				"command": "clineDesktop.searchSessions",
				"key": "ctrl+shift+k",
				"mac": "cmd+shift+k",
				"when": "focusedView == clineDesktop.sidebar || activeWebviewPanelId == clineDesktop.panel"
			},
			{
				"command": "clineDesktop.openSettings",
				"key": "ctrl+shift+,",
				"mac": "cmd+shift+,",
				"when": "focusedView == clineDesktop.sidebar || activeWebviewPanelId == clineDesktop.panel"
			},
			{
				"command": "clineDesktop.focusInput",
				"key": "ctrl+shift+l",
				"mac": "cmd+shift+l"
			},
			{
				"command": "clineDesktop.addToCline",
				"key": "ctrl+alt+l",
				"mac": "cmd+alt+l",
				"when": "editorTextFocus && editorHasSelection"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "clineDesktop",
					"title": "Cline Desktop",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"clineDesktop": [
				{
					"type": "webview",
					"id": "clineDesktop.sidebar",
					"name": "Cline",
					"icon": "media/icon.svg"
				}
			]
		},
		"configuration": {
			"title": "Cline Desktop",
			"properties": {
				"clineDesktop.bunPath": {
					"type": "string",
					"default": "",
					"description": "Path to the bun (or compiled cline CLI) binary used to run the desktop backend. Leave empty to resolve `bun` from PATH."
				},
				"clineDesktop.backendEntry": {
					"type": "string",
					"default": "",
					"description": "Path to the desktop backend entrypoint (sidecar/index.ts or a built bundle). Leave empty to use the copy bundled with this extension / repo checkout."
				}
			}
		},
		"menus": {
			"view/title": [
				{
					"command": "clineDesktop.newSession",
					"when": "view == clineDesktop.sidebar",
					"group": "navigation@1"
				},
				{
					"command": "clineDesktop.showSessions",
					"when": "view == clineDesktop.sidebar",
					"group": "navigation@2"
				},
				{
					"command": "clineDesktop.openSettings",
					"when": "view == clineDesktop.sidebar",
					"group": "navigation@3"
				},
				{
					"command": "clineDesktop.open",
					"when": "view == clineDesktop.sidebar",
					"group": "navigation@4"
				},
				{
					"command": "clineDesktop.restartBackend",
					"when": "view == clineDesktop.sidebar",
					"group": "z_backend@1"
				},
				{
					"command": "clineDesktop.showLogs",
					"when": "view == clineDesktop.sidebar",
					"group": "z_backend@2"
				}
			],
			"editor/title": [
				{
					"command": "clineDesktop.newSession",
					"when": "activeWebviewPanelId == clineDesktop.panel",
					"group": "navigation@1"
				},
				{
					"command": "clineDesktop.showSessions",
					"when": "activeWebviewPanelId == clineDesktop.panel",
					"group": "navigation@2"
				},
				{
					"command": "clineDesktop.openSettings",
					"when": "activeWebviewPanelId == clineDesktop.panel",
					"group": "navigation@3"
				}
			],
			"editor/context": [
				{
					"command": "clineDesktop.addToCline",
					"when": "editorHasSelection",
					"group": "0_cline@1"
				}
			],
			"commandPalette": [
				{
					"command": "clineDesktop.addToCline",
					"when": "editorHasSelection"
				}
			]
		}
	},
	"scripts": {
		"build:webview": "bun run scripts/build-webview.ts",
		"build:extension": "bun build ./src/extension.ts --outdir ./dist --target=node --format=cjs --external=vscode --sourcemap=linked",
		"build": "bun run build:webview --build && bun run build:extension",
		"watch": "bun build ./src/extension.ts --outdir ./dist --target=node --format=cjs --external=vscode --sourcemap=linked --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"build:runtime": "bun run scripts/build-runtime.ts",
		"package": "bun run build && bun run build:runtime && bunx @vscode/vsce package --no-dependencies --skip-license --target darwin-arm64 --out dist/",
		"package:win32-x64": "bun run build && bun run build:runtime --target bun-windows-x64 && bunx @vscode/vsce package --no-dependencies --skip-license --target win32-x64 --out dist/",
		"package:darwin-x64": "bun run build && bun run build:runtime --target bun-darwin-x64 && bunx @vscode/vsce package --no-dependencies --skip-license --target darwin-x64 --out dist/",
		"package:linux-x64": "bun run build && bun run build:runtime --target bun-linux-x64 && bunx @vscode/vsce package --no-dependencies --skip-license --target linux-x64 --out dist/"
	},
	"devDependencies": {
		"@types/node": "^25.3.5",
		"@types/vscode": "^1.90.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18",
		"@vscode/vsce": "^3.3.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cline/cline",
		"directory": "apps/examples/vscode-desktop"
	}
}
