{
    "name": "@bedrock-coder/packages",
    "private": true,
    "workspaces": [
        "sdk/packages/shared",
        "sdk/packages/llms",
        "sdk/packages/agents",
        "sdk/packages/core",
        "apps/vscode",
        "apps/vscode/webview-ui"
    ],
    "scripts": {
        "prepare": "husky",
        "build": "bun run clean && bun install && bun run build:sdk && bun --cwd apps/vscode package",
        "build:sdk": "bun --production -F './sdk/packages/*' build",
        "build:apps": "bun --cwd apps/vscode package",
        "dev": "bun --conditions=development run build:sdk && bun --cwd apps/vscode dev",
        "clean": "bun run sdk/scripts/clean.ts",
        "types": "bun --parallel -F '*' typecheck",
        "test": "bun --parallel -F './sdk/packages/**' test && bun --cwd apps/vscode test",
        "test:unit": "bun -F @bedrock-coder/agents test && bun -F @bedrock-coder/llms test && bun -F @bedrock-coder/core test:unit && bun --cwd apps/vscode test:unit",
        "test:e2e": "bun -F @bedrock-coder/core test:e2e && bun --cwd apps/vscode test:e2e",
        "biome": "bunx --bun @biomejs/biome",
        "format": "bun biome format sdk/ apps/vscode/",
        "lint": "bun biome lint sdk/ apps/vscode/",
        "fix": "bun biome check --write --unsafe --diagnostic-level=error sdk/ apps/vscode/",
        "check": "bun biome check --diagnostic-level=error sdk/ apps/vscode/ && bun run build:sdk && bun --cwd apps/vscode check-types",
        "version": "bun run types && bun sdk/scripts/version.ts"
    },
    "lint-staged": {
        "sdk/**": [
            "sh -c 'bun run types'",
            "bun biome check --no-errors-on-unmatched --files-ignore-unknown=true"
        ],
        "apps/vscode/**": [
            "sh -c 'bun run types'",
            "bun biome check --no-errors-on-unmatched --files-ignore-unknown=true"
        ]
    },
    "module": "index.ts",
    "type": "module",
    "engines": {
        "bun": "1.3.13",
        "node": ">=22"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.5",
        "@types/bun": "^1.3.13",
        "@types/node": "^25.3.5",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.2",
        "vitest": "^4.0.18"
    },
    "peerDependencies": {
        "nanoid": "^5.1.7",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "axios": "1.18.0",
        "tar-fs": ">=3.1.1",
        "tar": "^7.5.2",
        "js-yaml": "^4.1.1",
        "serialize-javascript": ">=7.0.3",
        "protobufjs": "7.6.5",
        "mermaid": "11.16.0",
        "diff": "8.0.4"
    },
    "packageManager": "bun@1.3.13"
}
